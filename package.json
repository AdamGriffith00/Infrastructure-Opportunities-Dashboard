{
  "name": "infrastructure-opportunities-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:globe && npm run build:copy",
    "build:globe": "vite build --config globe-react/vite.config.js",
    "build:copy": "mkdir -p globe && cp -r globe-react/dist/* globe/",
    "dev:globe": "vite --config globe-react/vite.config.js",
    "preview:globe": "vite preview --config globe-react/vite.config.js"
  },
  "dependencies": {
    "@netlify/blobs": "^6.0.0",
    "docx": "^8.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-globe.gl": "^2.27.1",
    "three": "^0.165.0",
    "d3-geo": "^3.1.0",
    "framer-motion": "^11.0.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0"
  }
}
